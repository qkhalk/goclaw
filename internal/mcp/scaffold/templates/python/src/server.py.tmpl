#!/usr/bin/env python3
"""{{.DisplayName}} — zero-dependency MCP stdio server.

Replace the example tool below with the real one; the JSON-RPC plumbing
(initialize / tools/list / tools/call / ping over newline-delimited
JSON-RPC 2.0) is complete as-is.
"""
import json
import sys

PROTOCOL_VERSION = "2025-06-18"

TOOLS = [
    {
        "name": "hello",
        "description": "Example tool — replace it with yours. Echoes a greeting.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "who": {"type": "string", "description": "Who to greet (default: world)."}
            },
        },
    }
]


def text_result(text):
    return {"content": [{"type": "text", "text": text}]}


def tool_hello(arguments):
    return text_result(f"hello, {arguments.get('who') or 'world'}!")


TOOL_CALLS = {"hello": tool_hello}


def handle(msg):
    method = msg.get("method")
    if method == "initialize":
        return {
            "protocolVersion": (msg.get("params") or {}).get("protocolVersion") or PROTOCOL_VERSION,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "{{.Name}}", "version": "0.1.0"},
        }
    if method == "tools/list":
        return {"tools": TOOLS}
    if method == "tools/call":
        params = msg.get("params") or {}
        name = params.get("name")
        fn = TOOL_CALLS.get(name)
        if fn is None:
            return {**text_result(f"error: unknown tool {name}"), "isError": True}
        try:
            return fn(params.get("arguments") or {})
        except Exception as e:  # surface tool errors as MCP isError results
            return {**text_result(f"error: {e}"), "isError": True}
    if method == "ping":
        return {}
    return {"error": {"code": -32601, "message": f"unknown method: {method}"}}


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue  # not JSON-RPC — ignore
        if msg.get("id") is None:
            continue  # notification (incl. initialized)
        try:
            result = handle(msg)
        except Exception as e:
            result = {"error": {"code": -32603, "message": str(e)}}
        sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": msg["id"], "result": result}) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
